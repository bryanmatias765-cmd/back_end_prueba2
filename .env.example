# Copiar este archivo como ".env".

# --- OPCIÓN POR DEFECTO: PostgreSQL propio del proyecto (automático) ---
# manage.py lo crea y lo enciende solo (ver bd_local.py). Requiere tener los
# programas de PostgreSQL en el PC; si no los encuentra, indicar la carpeta:
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
DB_LOCAL_AUTO=True
DB_ENGINE=postgresql
DB_NAME=tienda_hardware
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5433

# --- OPCIÓN NUBE: PostgreSQL en Neon (https://neon.tech) ---
# Si se define, tiene prioridad sobre todo lo anterior.
# DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxxxx.neon.tech/neondb?sslmode=require

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
